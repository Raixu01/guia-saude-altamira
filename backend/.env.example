# Configurações do Backend - Guia de Saúde Altamira
ENVIRONMENT=development
API_V1_STR=/api

# Banco de Dados (Por padrão usa SQLite local para desenvolvimento sem atrito.
# Para produção / Supabase, use: postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres)
DATABASE_URL=sqlite:///./guia_saude.db

# CORS: origens permitidas (Next.js / React local ou Vercel)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
